# bash completion for zfs-snap-clean
# Installation: sudo make install-completion
# Manual:       sudo cp completion/zfs-snap-clean /etc/bash_completion.d/

_zfs_snap_clean() {
    local cur prev
    # Use bash-completion helper when available, otherwise fall back manually.
    if declare -f _init_completion &>/dev/null; then
        _init_completion || return
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
        prev="${COMP_WORDS[COMP_CWORD-1]}"
    fi

    local opts="-n --dry-run -r --recursive -v --verbose \
                -c --config -a --min-age -l --log-dir -s --sep -h --help"
    local freqs="minutely hourly daily weekly monthly yearly"

    case "$prev" in
        -c|--config)
            # Complete .conf files, fall back to generic file completion.
            if declare -f _filedir &>/dev/null; then
                _filedir '*.conf'
            else
                COMPREPLY=( $(compgen -f -- "$cur") )
            fi
            return ;;

        -l|--log-dir)
            if declare -f _filedir &>/dev/null; then
                _filedir -d
            else
                COMPREPLY=( $(compgen -d -- "$cur") )
            fi
            return ;;

        -s|--sep)
            # Common separators; empty string means no separator.
            COMPREPLY=( $(compgen -W '. - _ ""' -- "$cur") )
            return ;;

        -a|--min-age)
            # Before the '=': propose frequency names followed by '='.
            # After the '=':  propose common age specs for the chosen frequency.
            local common_ages="1h 4h 12h 24h 48h 2d 7d 14d 30d 1w 2w 4w 8w 1m 2m 3m 6m 1y"
            if [[ "$cur" == *=* ]]; then
                local freq="${cur%%=*}"
                local candidates
                candidates=$(printf "${freq}=%s\n" $common_ages)
                COMPREPLY=( $(compgen -W "$candidates" -- "$cur") )
            else
                local candidates
                candidates=$(printf '%s=\n' $freqs)
                COMPREPLY=( $(compgen -W "$candidates" -- "$cur") )
                compopt -o nospace 2>/dev/null
            fi
            return ;;
    esac

    # Options
    if [[ "$cur" == -* ]]; then
        COMPREPLY=( $(compgen -W "$opts" -- "$cur") )
        return
    fi

    # Positional arguments: ZFS filesystem names.
    local filesystems
    filesystems=$(zfs list -H -o name -t filesystem 2>/dev/null)
    COMPREPLY=( $(compgen -W "$filesystems" -- "$cur") )
}

complete -F _zfs_snap_clean zfs-snap-clean.sh
complete -F _zfs_snap_clean zfs-snap-clean
